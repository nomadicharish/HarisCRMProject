NODE_ENV=production
APP_NAME=Talent Acquisition
# Use qa for the current Firebase project. Set production only after production
# credentials and bucket are configured in the deployment environment.
FIREBASE_ENVIRONMENT=qa
# Dev uses the Cloud Run source bucket until a dedicated Firebase Storage bucket
# is provisioned for the Dev project. QA and production have separate values.
FIREBASE_DEV_STORAGE_BUCKET=run-sources-talent-aquisition-dev-asia-south1
FIREBASE_QA_STORAGE_BUCKET=haris-business-crm.firebasestorage.app
FIREBASE_PROD_STORAGE_BUCKET=haris-business-crm.firebasestorage.app
# Optional Firestore database ID. QA uses Firebase's standard `(default)` ID;
# set this only if a target project uses a differently named database.
# FIREBASE_FIRESTORE_DATABASE_ID=default
# Optional target-specific credentials. If omitted, the existing generic
# FIREBASE_SERVICE_ACCOUNT_BASE64 / FIREBASE_SERVICE_ACCOUNT_JSON values are used.
# FIREBASE_QA_SERVICE_ACCOUNT_BASE64=
# FIREBASE_PROD_SERVICE_ACCOUNT_BASE64=
CORS_ALLOWED_ORIGINS=https://your-crm-domain.example
DATA_ENCRYPTION_KEY_BASE64=replace-with-a-32-byte-base64-key
MALWARE_SCAN_REQUIRED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=15000
