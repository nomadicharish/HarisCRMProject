rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The browser uses this one document only for the live unread badge.
    // All notification messages and mutations continue through the API.
    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }
  }
}
